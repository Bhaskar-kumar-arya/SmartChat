{
  "id": "com.smartchat.voice-transcriber",
  "name": "Voice Transcriber Plugin",
  "version": "1.0.0",
  "apiVersion": "2",
  "main": "index.js",
  "description": "External microkernel plugin that transcribes English audio messages and displays the result in a copyable webview overlay.",
  "permissions": [
    "messages:read",
    "messages:send",
    "ai:chat",
    "storage:read",
    "storage:write",
    "ui:notification",
    "ui:toast",
    "ui:overlay",
    "ui:panel",
    "events:*"
  ],
  "contributions": {
    "messageActions": [
      {
        "id": "transcribe",
        "label": "Transcribe Audio",
        "icon": "mic",
        "when": {
          "field": "message.messageType",
          "op": "in",
          "value": ["audioMessage", "ptvMessage"]
        }
      }
    ],
    "sidebarPanels": [
      {
        "id": "transcription-history",
        "title": "Voice Transcriptions",
        "panel": "panels/transcriptions.html",
        "icon": "mic"
      }
    ]
  }
}
