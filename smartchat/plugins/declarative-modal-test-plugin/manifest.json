{
  "id": "com.smartchat.declarative-modal-test",
  "name": "Declarative Modal Test Plugin",
  "version": "1.0.0",
  "apiVersion": "2",
  "main": "index.js",
  "permissions": [
    "ui:notification",
    "ui:modal",
    "ui:toast",
    "ui:overlay",
    "chats:read",
    "chats:write",
    "messages:read",
    "messages:send",
    "messages:write"
  ],
  "contributions": {
    "slashCommands": [
      {
        "name": "overlay",
        "description": "Opens Webview Overlay to compose and send a message to the active chat"
      }
    ],
    "chatActions": [
      {
        "id": "test-form-action",
        "label": "Test Form Modal",
        "icon": "zap"
      },
      {
        "id": "test-confirm-action",
        "label": "Test Confirm Modal",
        "icon": "zap"
      },
      {
        "id": "test-alert-action",
        "label": "Test Alert Modal",
        "icon": "zap"
      },
      {
        "id": "test-overlay-action",
        "label": "Test Webview Overlay",
        "icon": "layout"
      }
    ]
  }
}