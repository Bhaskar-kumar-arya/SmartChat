{
  "id": "com.smartchat.test-all-features",
  "name": "Microkernel All-Features Test Plugin",
  "version": "1.0.0",
  "apiVersion": "2",
  "main": "index.js",
  "description": "External test plugin validating all supported contribution slots and kernel API modules.",
  "permissions": [
    "chats:read",
    "chats:write",
    "messages:read",
    "messages:send",
    "messages:delete",
    "contacts:read",
    "ai:chat",
    "ai:tools:call",
    "ai:tools:register",
    "storage:read",
    "storage:write",
    "ui:notification",
    "ui:toast",
    "ui:panel",
    "events:*",
    "scheduler"
  ],
  "contributions": {
    "chatActions": [
      {
        "id": "test-chat-action",
        "label": "Test Chat Action",
        "icon": "flask"
      }
    ],
    "messageActions": [
      {
        "id": "test-message-action",
        "label": "Test Message Action",
        "icon": "zap"
      }
    ],
    "slashCommands": [
      {
        "name": "test-cmd",
        "description": "Executes test slash command"
      }
    ],
    "sidebarPanels": [
      {
        "id": "test-sidebar",
        "title": "Test Sidebar Panel",
        "panel": "panels/sidebar.html",
        "icon": "layout"
      }
    ],
    "settingsPages": [
      {
        "id": "test-settings",
        "title": "Test Settings Page",
        "panel": "panels/settings.html"
      }
    ],

    "aiTools": [
      {
        "name": "test_plugin_tool",
        "description": "AI tool provided by test plugin",
        "schema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" }
          },
          "required": ["query"]
        }
      }
    ]
  }
}
